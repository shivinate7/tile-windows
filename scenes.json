{
  "version": 1,
  "categories": [["code", "Code"], ["browse", "Browse"], ["comms", "Comms"], ["other", "Other"]],
  "cats": {
    "claude": "code", "Code": "code", "WindowsTerminal": "code", "powershell": "code", "pwsh": "code", "devenv": "code",
    "chrome": "browse", "msedge": "browse", "firefox": "browse", "brave": "browse",
    "ms-teams": "comms", "olk": "comms", "outlook": "comms", "slack": "comms", "Zoom": "comms"
  },
  "scenes": [
    {
      "id": "default", "name": "Default", "builtIn": true,
      "blurb": "Portrait: Outlook over Teams. Laptop: new Outlook. Ultrawide: Claude, Chrome, then the rest.",
      "trigger": { "type": "manual", "days": [1, 2, 3, 4, 5], "time": "08:30" },
      "grids": { "tall": { "c": 1, "r": 2 }, "laptop": { "c": 1, "r": 1 }, "wide": { "c": 5, "r": 2 } },
      "pins": [
        { "app": "outlook", "match": "- Outlook", "mon": "tall", "slots": [0] },
        { "app": "ms-teams", "match": "", "mon": "tall", "slots": [1] },
        { "app": "olk", "match": "", "mon": "laptop", "slots": [0] }
      ],
      "fill": { "mon": "wide", "apps": ["claude", "chrome", "*"], "skip": ["outlook", "olk", "ms-teams"], "sort": "app" }
    },
    {
      "id": "focus", "name": "Focus",
      "blurb": "Three big columns: a browser, then two Claude windows. Mail and chat stay on the side screens.",
      "trigger": { "type": "manual", "days": [1, 2, 3, 4], "time": "09:00" },
      "grids": { "tall": { "c": 1, "r": 2 }, "laptop": { "c": 1, "r": 1 }, "wide": { "c": 3, "r": 1 } },
      "pins": [
        { "app": "chrome", "match": "", "mon": "wide", "slots": [0] },
        { "app": "outlook", "match": "- Outlook", "mon": "tall", "slots": [0] },
        { "app": "ms-teams", "match": "", "mon": "tall", "slots": [1] },
        { "app": "olk", "match": "", "mon": "laptop", "slots": [0] }
      ],
      "fill": { "mon": "wide", "apps": ["claude"], "skip": ["outlook", "olk", "ms-teams"], "sort": "app" }
    },
    {
      "id": "meetings", "name": "Meetings",
      "blurb": "Teams takes the left half of the ultrawide. Both mail apps stack on the portrait.",
      "trigger": { "type": "manual", "days": [1, 2, 3, 4, 5], "time": "11:00" },
      "grids": { "tall": { "c": 1, "r": 2 }, "laptop": { "c": 1, "r": 1 }, "wide": { "c": 4, "r": 2 } },
      "pins": [
        { "app": "ms-teams", "match": "", "mon": "wide", "slots": [0, 1, 4, 5] },
        { "app": "outlook", "match": "", "mon": "tall", "slots": [0] },
        { "app": "olk", "match": "", "mon": "tall", "slots": [1] }
      ],
      "fill": { "mon": "wide", "apps": ["claude", "chrome", "*"], "skip": ["outlook", "olk", "ms-teams"], "sort": "category" }
    },
    {
      "id": "review", "name": "Review",
      "blurb": "A browser big on the left of the ultrawide. Everything else fills by title.",
      "trigger": { "type": "manual", "days": [5], "time": "14:00" },
      "grids": { "tall": { "c": 1, "r": 2 }, "laptop": { "c": 1, "r": 1 }, "wide": { "c": 4, "r": 2 } },
      "pins": [
        { "app": "chrome", "match": "", "mon": "wide", "slots": [0, 1, 4, 5] },
        { "app": "outlook", "match": "- Outlook", "mon": "tall", "slots": [0] },
        { "app": "ms-teams", "match": "", "mon": "tall", "slots": [1] },
        { "app": "olk", "match": "", "mon": "laptop", "slots": [0] }
      ],
      "fill": { "mon": "wide", "apps": ["claude", "*"], "skip": ["outlook", "olk", "ms-teams"], "sort": "title" }
